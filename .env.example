# ---------------------------------------------------------------------------
# 3GPP RAG Assistant — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and edit values as needed:
#   cp .env.example .env
#
# All values shown are defaults. Only set variables you want to change.
# The app runs perfectly with an empty .env file (all defaults apply).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LLM Provider — choose "ollama" (local), "groq" (cloud), or "openai" (cloud)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

# ---------------------------------------------------------------------------
# Ollama (local LLM) — no API key needed
# Install: https://ollama.com  |  Start: ollama serve
# Only used when LLM_PROVIDER=ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# Model to use — must be pulled first: ollama pull <model>
# llama3.2   ~2GB  good balance (default)
# mistral    ~4GB  strong technical reasoning
# phi3       ~2GB  very fast
# llama3.1   ~5GB  best quality on CPU
LLM_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Groq (cloud LLM) — free API key from https://console.groq.com/keys
# Only used when LLM_PROVIDER=groq
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# OpenAI LLM and embeddings (cloud)
# Used when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM generation parameters
MAX_TOKENS=1000
TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Embeddings — local sentence-transformers, no API key needed
# IMPORTANT: must match the model used to build the vector index.
# Changing this requires a full re-index (build_index.py).
# ---------------------------------------------------------------------------
# Options: mini (fast, 80MB), mpnet (balanced), bge-small (tech docs, default), bge-base (best)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=bge-small

# ---------------------------------------------------------------------------
# Vector Database (ChromaDB) — requires chromadb>=0.5.0
# ---------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=pinecone
VECTOR_DB_PATH=./data/vectordb
COLLECTION_NAME=3gpp_specs

# ---------------------------------------------------------------------------
# Pinecone Vector Database (cloud)
# Only used by src/core/pinecone_store.py when explicitly instantiated
# ---------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=3gpp-rag
PINECONE_NAMESPACE=3gpp-specs

# ---------------------------------------------------------------------------
# Document Processing
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIR=./data/raw

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
MAX_HISTORY_LENGTH=5
TOP_K_RESULTS=5

# Evidence gate. These reranker thresholds were calibrated for the indexed
# TS 38.300 + TS 38.401 corpus with text-embedding-3-small and
# cross-encoder/ms-marco-MiniLM-L6-v2; do not treat them as universal.
EVIDENCE_GATE_ENABLED=true
EVIDENCE_MIN_TOP_SCORE=0.80
EVIDENCE_MIN_DOC_SCORE=0.80
EVIDENCE_MIN_DOCS=2
EVIDENCE_MEAN_TOP_N=3
EVIDENCE_MIN_MEAN_SCORE=0.0
# vector = original Pinecone/OpenAI embedding similarity; reranker = cross-encoder score
EVIDENCE_SCORE_SOURCE=reranker

# Post-generation grounding and citation verification
ANSWER_VERIFICATION_ENABLED=true
# Defaults to OPENAI_MODEL when empty
OPENAI_VERIFIER_MODEL=

# Cross-encoder reranking between vector retrieval and EvidenceGate
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_CANDIDATE_K=10
RERANKER_TOP_K=5

# Query-time 3GPP vocabulary expansion (appends full forms of known
# abbreviations before embedding; see src/core/query_expansion.py)
QUERY_EXPANSION=true

# Comparison-query decomposition ("difference between X and Y" issues one
# sub-query per side; see src/core/query_decomposition.py)
QUERY_DECOMPOSITION=true
